# PostgreSQL connection string
# FORMAT: postgresql://[user]:[password]@[host]:[port]/[database]
# REPLACE <YOUR_PASSWORD> with the password you chose during PostgreSQL installation
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/game_services"

# A secure random secret key for authentication sessions.
# You can generate a random string or keep this one for local development.
BETTER_AUTH_SECRET="I_love_Mint_aka_Thuy_Le_aka_my_wife"

# The local URL where the Next.js frontend will run
BETTER_AUTH_URL="http://localhost:3000"

# Optional secret to protect the matchmaking tick endpoint (leave blank for local test)
WORKER_SECRET=""
